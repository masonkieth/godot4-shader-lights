; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Shader Lighting Demo"
run/main_scene="res://demo/demo.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://addons/shader_lighting/icon.svg"

[autoload]

ShaderLighting="*uid://d76i5g2kvw7r"

[editor_plugins]

enabled=PackedStringArray("res://addons/shader_lighting/plugin.cfg")

[shader_globals]

light_buffer={
"type": "sampler2D",
"value": "res://addons/shader_lighting/black.png"
}
light_buffer_1={
"type": "sampler2D",
"value": "res://addons/shader_lighting/black.png"
}
light_buffer_2={
"type": "sampler2D",
"value": "res://addons/shader_lighting/black.png"
}
light_buffer_3={
"type": "sampler2D",
"value": "res://addons/shader_lighting/black.png"
}
ambient_color={
"type": "color",
"value": Color(1, 1, 1, 1)
}
lighting_on={
"type": "bool",
"value": false
}

[shader_lighting]

occlusion_mask=1
